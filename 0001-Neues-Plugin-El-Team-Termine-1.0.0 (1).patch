+<?php
+/**
+ * Plugin Name: El-Team Termine
+ * Description: Termine (Treffen, El-Café, Ausfahrten) mit Datum, Ort und Anmeldung; Übersicht kommender und vergangener Termine, Kalender-Download (iCal) und Shortcode [termine].
+ * Version: 1.0.0
+ * Requires at least: 5.5
+ * Requires PHP: 7.4
+ * Author: Lukas Nacke
+ * License: GPL-3.0-or-later
+ * Text Domain: el-team-termine
+ */
+
+if ( ! defined( 'ABSPATH' ) ) {
+	exit;
+}
+
+define( 'EL_TEAM_TERMINE_VERSION', '1.0.0' );
+define( 'EL_TEAM_TERMINE_FILE', __FILE__ );
+define( 'EL_TEAM_TERMINE_DIR', plugin_dir_path( __FILE__ ) );
+define( 'EL_TEAM_TERMINE_URL', plugin_dir_url( __FILE__ ) );
+
+require_once EL_TEAM_TERMINE_DIR . 'includes/post-type.php';
+require_once EL_TEAM_TERMINE_DIR . 'includes/termin.php';
+require_once EL_TEAM_TERMINE_DIR . 'includes/admin.php';
+require_once EL_TEAM_TERMINE_DIR . 'includes/frontend.php';
+require_once EL_TEAM_TERMINE_DIR . 'includes/ical.php';
+
+/**
+ * Beim Aktivieren: Inhaltstyp registrieren und Adressen (/termine/) neu aufbauen.
+ */
+function el_team_termine_activate() {
+	el_team_termine_register();
+	flush_rewrite_rules();
+}
+register_activation_hook( __FILE__, 'el_team_termine_activate' );
+
+/**
+ * Beim Deaktivieren: Adressen ohne /termine/ neu aufbauen. Die Termine selbst bleiben erhalten.
+ */
+function el_team_termine_deactivate() {
+	flush_rewrite_rules();
+}
+register_deactivation_hook( __FILE__, 'el_team_termine_deactivate' );
diff --git a/el-team-termine/includes/admin.php b/el-team-termine/includes/admin.php
new file mode 100644
index 0000000..87c454b
--- /dev/null
+++ b/el-team-termine/includes/admin.php
@@ -0,0 +1,241 @@
+<?php
+/**
+ * Adminbereich: Eingabekasten "Termin", Spalten und Sortierung der Terminliste.
+ */
+
+if ( ! defined( 'ABSPATH' ) ) {
+	exit;
+}
+
+/**
+ * Eingabekasten "Termin" beim Bearbeiten.
+ */
+function el_team_termine_add_meta_box() {
+	add_meta_box( 'el-team-termin', __( 'Termin', 'el-team-termine' ), 'el_team_termine_render_meta_box', 'termin', 'normal', 'high' );
+}
+add_action( 'add_meta_boxes', 'el_team_termine_add_meta_box' );
+
+/**
+ * Teilt "Y-m-d H:i" in Datum und Uhrzeit für die Eingabefelder.
+ *
+ * @param string $wert gespeicherter Wert
+ * @return array Datum (Y-m-d), Uhrzeit (H:i)
+ */
+function el_team_termine_split( $wert ) {
+	$teile = explode( ' ', (string) $wert );
+	return array( isset( $teile[0] ) ? $teile[0] : '', isset( $teile[1] ) ? $teile[1] : '' );
+}
+
+/**
+ * Inhalt des Eingabekastens.
+ *
+ * @param WP_Post $post Termin
+ */
+function el_team_termine_render_meta_box( $post ) {
+	wp_nonce_field( 'el_team_termin_speichern', 'el_team_termin_nonce' );
+	list( $beginn_datum, $beginn_zeit ) = el_team_termine_split( get_post_meta( $post->ID, '_el_termin_beginn', true ) );
+	list( $ende_datum, $ende_zeit )     = el_team_termine_split( get_post_meta( $post->ID, '_el_termin_ende', true ) );
+	$ganztags  = (bool) get_post_meta( $post->ID, '_el_termin_ganztags', true );
+	$status    = (string) get_post_meta( $post->ID, '_el_termin_status', true );
+	?>
+	<table class="form-table" role="presentation">
+		<tr>
+			<th scope="row"><label for="el-termin-beginn"><?php esc_html_e( 'Beginn', 'el-team-termine' ); ?></label></th>
+			<td>
+				<input type="date" id="el-termin-beginn" name="el_termin[beginn_datum]" value="<?php echo esc_attr( $beginn_datum ); ?>" required>
+				<input type="time" name="el_termin[beginn_zeit]" value="<?php echo esc_attr( $beginn_zeit ); ?>" aria-label="<?php esc_attr_e( 'Uhrzeit Beginn', 'el-team-termine' ); ?>">
+			</td>
+		</tr>
+		<tr>
+			<th scope="row"><label for="el-termin-ende"><?php esc_html_e( 'Ende', 'el-team-termine' ); ?></label></th>
+			<td>
+				<input type="date" id="el-termin-ende" name="el_termin[ende_datum]" value="<?php echo esc_attr( $ende_datum ); ?>">
+				<input type="time" name="el_termin[ende_zeit]" value="<?php echo esc_attr( $ende_zeit ); ?>" aria-label="<?php esc_attr_e( 'Uhrzeit Ende', 'el-team-termine' ); ?>">
+				<p class="description"><?php esc_html_e( 'Optional. Nur eine Uhrzeit ohne Datum gilt für den Tag des Beginns.', 'el-team-termine' ); ?></p>
+			</td>
+		</tr>
+		<tr>
+			<th scope="row"><?php esc_html_e( 'Ganztägig', 'el-team-termine' ); ?></th>
+			<td><label><input type="checkbox" name="el_termin[ganztags]" value="1" <?php checked( $ganztags ); ?>> <?php esc_html_e( 'ohne Uhrzeit (z. B. mehrtägiges Treffen)', 'el-team-termine' ); ?></label></td>
+		</tr>
+		<tr>
+			<th scope="row"><label for="el-termin-ort"><?php esc_html_e( 'Ort', 'el-team-termine' ); ?></label></th>
+			<td><input type="text" id="el-termin-ort" class="regular-text" name="el_termin[ort]" value="<?php echo esc_attr( get_post_meta( $post->ID, '_el_termin_ort', true ) ); ?>" placeholder="<?php esc_attr_e( 'z. B. Werkstatt Olfen', 'el-team-termine' ); ?>"></td>
+		</tr>
+		<tr>
+			<th scope="row"><label for="el-termin-adresse"><?php esc_html_e( 'Adresse', 'el-team-termine' ); ?></label></th>
+			<td>
+				<input type="text" id="el-termin-adresse" class="large-text" name="el_termin[adresse]" value="<?php echo esc_attr( get_post_meta( $post->ID, '_el_termin_adresse', true ) ); ?>" placeholder="<?php esc_attr_e( 'Straße Nr., PLZ Ort', 'el-team-termine' ); ?>">
+				<p class="description"><?php esc_html_e( 'Mit Adresse erscheint ein Link „Auf der Karte zeigen“ (OpenStreetMap). Es wird keine Karte eingebettet.', 'el-team-termine' ); ?></p>
+			</td>
+		</tr>
+		<tr>
+			<th scope="row"><label for="el-termin-anmeldung"><?php esc_html_e( 'Anmeldung / Infos', 'el-team-termine' ); ?></label></th>
+			<td><input type="url" id="el-termin-anmeldung" class="large-text" name="el_termin[anmeldung]" value="<?php echo esc_attr( get_post_meta( $post->ID, '_el_termin_anmeldung', true ) ); ?>" placeholder="https://"></td>
+		</tr>
+		<tr>
+			<th scope="row"><label for="el-termin-status"><?php esc_html_e( 'Status', 'el-team-termine' ); ?></label></th>
+			<td>
+				<select id="el-termin-status" name="el_termin[status]">
+					<?php foreach ( el_team_termin_status_liste() as $wert => $bezeichnung ) : ?>
+						<option value="<?php echo esc_attr( $wert ); ?>" <?php selected( $status, $wert ); ?>><?php echo esc_html( $bezeichnung ); ?></option>
+					<?php endforeach; ?>
+				</select>
+			</td>
+		</tr>
+	</table>
+	<?php
+}
+
+/**
+ * Speichert die Termin-Felder.
+ *
+ * @param int $post_id Termin
+ */
+function el_team_termine_save( $post_id ) {
+	if ( ! isset( $_POST['el_team_termin_nonce'] ) || ! wp_verify_nonce( sanitize_key( $_POST['el_team_termin_nonce'] ), 'el_team_termin_speichern' ) ) {
+		return;
+	}
+	if ( ( defined( 'DOING_AUTOSAVE' ) && DOING_AUTOSAVE ) || ! current_user_can( 'edit_post', $post_id ) ) {
+		return;
+	}
+	$in = isset( $_POST['el_termin'] ) && is_array( $_POST['el_termin'] ) ? wp_unslash( $_POST['el_termin'] ) : array();
+
+	$datum = function ( $key ) use ( $in ) {
+		$wert = isset( $in[ $key ] ) ? sanitize_text_field( $in[ $key ] ) : '';
+		return preg_match( '/^\d{4}-\d{2}-\d{2}$/', $wert ) ? $wert : '';
+	};
+	$zeit  = function ( $key ) use ( $in ) {
+		$wert = isset( $in[ $key ] ) ? sanitize_text_field( $in[ $key ] ) : '';
+		return preg_match( '/^\d{2}:\d{2}$/', $wert ) ? $wert : '';
+	};
+
+	$ganztags     = ! empty( $in['ganztags'] );
+	$beginn_datum = $datum( 'beginn_datum' );
+	$ende_datum   = $datum( 'ende_datum' );
+	$ende_zeit    = $zeit( 'ende_zeit' );
+	if ( '' === $ende_datum && '' !== $ende_zeit ) {
+		$ende_datum = $beginn_datum;
+	}
+
+	$beginn = '' !== $beginn_datum ? $beginn_datum . ' ' . ( $ganztags || '' === $zeit( 'beginn_zeit' ) ? '00:00' : $zeit( 'beginn_zeit' ) ) : '';
+	$ende   = '' !== $ende_datum ? $ende_datum . ' ' . ( $ganztags || '' === $ende_zeit ? '23:59' : $ende_zeit ) : '';
+	if ( '' !== $ende && $ende < $beginn ) {
+		$ende = '';
+	}
+	// Bis wann der Termin als "kommend" gilt
+	if ( '' !== $ende ) {
+		$bis = $ende;
+	} elseif ( '' !== $beginn ) {
+		$bis = $ganztags ? $beginn_datum . ' 23:59' : $beginn;
+	} else {
+		$bis = '';
+	}
+
+	$status = isset( $in['status'] ) ? sanitize_key( $in['status'] ) : '';
+	if ( ! array_key_exists( $status, el_team_termin_status_liste() ) ) {
+		$status = '';
+	}
+
+	$felder = array(
+		'_el_termin_beginn'    => $beginn,
+		'_el_termin_ende'      => $ende,
+		'_el_termin_bis'       => $bis,
+		'_el_termin_ganztags'  => $ganztags ? '1' : '',
+		'_el_termin_ort'       => isset( $in['ort'] ) ? sanitize_text_field( $in['ort'] ) : '',
+		'_el_termin_adresse'   => isset( $in['adresse'] ) ? sanitize_text_field( $in['adresse'] ) : '',
+		'_el_termin_anmeldung' => isset( $in['anmeldung'] ) ? esc_url_raw( $in['anmeldung'] ) : '',
+		'_el_termin_status'    => $status,
+	);
+	foreach ( $felder as $key => $wert ) {
+		if ( '' === $wert ) {
+			delete_post_meta( $post_id, $key );
+		} else {
+			update_post_meta( $post_id, $key, $wert );
+		}
+	}
+}
+add_action( 'save_post_termin', 'el_team_termine_save' );
+
+/**
+ * Spalten der Terminliste.
+ *
+ * @param array $spalten Spalten
+ * @return array
+ */
+function el_team_termine_columns( $spalten ) {
+	$neu = array();
+	foreach ( $spalten as $key => $titel ) {
+		$neu[ $key ] = $titel;
+		if ( 'title' === $key ) {
+			$neu['el_termin_zeit'] = __( 'Termin', 'el-team-termine' );
+			$neu['el_termin_ort']  = __( 'Ort', 'el-team-termine' );
+		}
+	}
+	unset( $neu['date'] );
+	return $neu;
+}
+add_filter( 'manage_termin_posts_columns', 'el_team_termine_columns' );
+
+/**
+ * Inhalt der Spalten.
+ *
+ * @param string $spalte  Spalte
+ * @param int    $post_id Termin
+ */
+function el_team_termine_column_content( $spalte, $post_id ) {
+	if ( 'el_termin_zeit' === $spalte ) {
+		$text   = el_team_termin_zeit_text( $post_id );
+		$status = (string) get_post_meta( $post_id, '_el_termin_status', true );
+		echo esc_html( '' !== $text ? $text : __( '– kein Datum –', 'el-team-termine' ) );
+		if ( '' !== $status ) {
+			echo ' <strong>(' . esc_html( el_team_termin_status_liste()[ $status ] ) . ')</strong>';
+		}
+	} elseif ( 'el_termin_ort' === $spalte ) {
+		echo esc_html( get_post_meta( $post_id, '_el_termin_ort', true ) );
+	}
+}
+add_action( 'manage_termin_posts_custom_column', 'el_team_termine_column_content', 10, 2 );
+
+/**
+ * Spalte "Termin" ist sortierbar.
+ *
+ * @param array $spalten sortierbare Spalten
+ * @return array
+ */
+function el_team_termine_sortable( $spalten ) {
+	$spalten['el_termin_zeit'] = 'el_termin_zeit';
+	return $spalten;
+}
+add_filter( 'manage_edit-termin_sortable_columns', 'el_team_termine_sortable' );
+
+/**
+ * Terminliste im Admin: nach Termin sortieren, ohne Auswahl die neuesten zuerst.
+ *
+ * @param WP_Query $query Abfrage
+ */
+function el_team_termine_admin_order( $query ) {
+	if ( ! is_admin() || ! $query->is_main_query() || 'termin' !== $query->get( 'post_type' ) ) {
+		return;
+	}
+	$orderby = $query->get( 'orderby' );
+	if ( '' === $orderby || 'el_termin_zeit' === $orderby ) {
+		// Termine ohne Datum (z. B. Entwürfe) bleiben in der Liste
+		$query->set( 'meta_query', array(
+			'relation'       => 'OR',
+			'el_termin_zeit' => array(
+				'key'     => '_el_termin_beginn',
+				'compare' => 'EXISTS',
+			),
+			'el_termin_ohne' => array(
+				'key'     => '_el_termin_beginn',
+				'compare' => 'NOT EXISTS',
+			),
+		) );
+		$query->set( 'orderby', 'el_termin_zeit' );
+		if ( '' === $orderby ) {
+			$query->set( 'order', 'DESC' );
+		}
+	}
+}
+add_action( 'pre_get_posts', 'el_team_termine_admin_order' );
diff --git a/el-team-termine/includes/frontend.php b/el-team-termine/includes/frontend.php
new file mode 100644
index 0000000..8e0467c
--- /dev/null
+++ b/el-team-termine/includes/frontend.php
@@ -0,0 +1,314 @@
+<?php
+/**
+ * Ausgabe auf der Website: Übersicht /termine/, Infokasten am Termin, Shortcode [termine],
+ * Terminliste (auch für die Startseite des Themes) und strukturierte Daten (schema.org/Event).
+ */
+
+if ( ! defined( 'ABSPATH' ) ) {
+	exit;
+}
+
+/**
+ * Styles der Termin-Ausgabe. Sie nutzen die Farben des Themes (--el-color-…), wenn vorhanden.
+ */
+function el_team_termine_enqueue() {
+	wp_enqueue_style( 'el-team-termine', EL_TEAM_TERMINE_URL . 'assets/termine.css', array(), EL_TEAM_TERMINE_VERSION );
+}
+add_action( 'wp_enqueue_scripts', 'el_team_termine_enqueue', 20 );
+
+/**
+ * Abfrage-Variable "zeitraum" für /termine/?zeitraum=vergangen.
+ *
+ * @param array $vars Abfrage-Variablen
+ * @return array
+ */
+function el_team_termine_query_var( $vars ) {
+	$vars[] = 'zeitraum';
+	return $vars;
+}
+add_filter( 'query_vars', 'el_team_termine_query_var' );
+
+/**
+ * Ist die aktuelle Seite die Termin-Übersicht oder eine Terminart?
+ *
+ * @return bool
+ */
+function el_team_termine_is_archive() {
+	return is_post_type_archive( 'termin' ) || is_tax( 'terminart' );
+}
+
+/**
+ * Übersicht /termine/ und Terminarten: kommende Termine nach Datum, mit ?zeitraum=vergangen die vergangenen.
+ *
+ * @param WP_Query $query Abfrage
+ */
+function el_team_termine_archive_query( $query ) {
+	if ( is_admin() || ! $query->is_main_query() || ! ( $query->is_post_type_archive( 'termin' ) || $query->is_tax( 'terminart' ) ) ) {
+		return;
+	}
+	$zeitraum = 'vergangen' === $query->get( 'zeitraum' ) ? 'vergangen' : 'kommend';
+	foreach ( el_team_termine_query_vars( $zeitraum ) as $key => $wert ) {
+		$query->set( $key, $wert );
+	}
+	$query->set( 'posts_per_page', 20 );
+}
+add_action( 'pre_get_posts', 'el_team_termine_archive_query' );
+
+/**
+ * Überschrift der Übersicht.
+ *
+ * @param string $titel Überschrift
+ * @return string
+ */
+function el_team_termine_archive_title( $titel ) {
+	if ( ! el_team_termine_is_archive() ) {
+		return $titel;
+	}
+	$vergangen = 'vergangen' === get_query_var( 'zeitraum' );
+	if ( is_tax( 'terminart' ) ) {
+		$art = single_term_title( '', false );
+		/* translators: %s: Terminart, z. B. El-Café */
+		return $vergangen ? sprintf( __( 'Vergangene Termine: %s', 'el-team-termine' ), $art ) : sprintf( __( 'Termine: %s', 'el-team-termine' ), $art );
+	}
+	return $vergangen ? __( 'Vergangene Termine', 'el-team-termine' ) : __( 'Termine', 'el-team-termine' );
+}
+add_filter( 'get_the_archive_title', 'el_team_termine_archive_title' );
+
+/**
+ * Unter der Überschrift: Wechsel zwischen kommenden und vergangenen Terminen, Kalender abonnieren.
+ *
+ * @param string $beschreibung Beschreibung
+ * @return string
+ */
+function el_team_termine_archive_description( $beschreibung ) {
+	if ( ! el_team_termine_is_archive() ) {
+		return $beschreibung;
+	}
+	$basis     = is_tax( 'terminart' ) ? get_term_link( get_queried_object() ) : get_post_type_archive_link( 'termin' );
+	$vergangen = 'vergangen' === get_query_var( 'zeitraum' );
+	$links     = array(
+		$vergangen
+			? '<a href="' . esc_url( $basis ) . '">' . esc_html__( 'Kommende Termine', 'el-team-termine' ) . '</a>'
+			: '<a href="' . esc_url( add_query_arg( 'zeitraum', 'vergangen', $basis ) ) . '">' . esc_html__( 'Vergangene Termine', 'el-team-termine' ) . '</a>',
+		'<a href="' . esc_url( el_team_termine_ics_url() ) . '">' . esc_html__( 'Alle Termine im eigenen Kalender abonnieren (iCal)', 'el-team-termine' ) . '</a>',
+	);
+	return $beschreibung . '<p class="el-termine-links">' . implode( '<span aria-hidden="true"> · </span>', $links ) . '</p>';
+}
+add_filter( 'get_the_archive_description', 'el_team_termine_archive_description' );
+
+/**
+ * Bei Terminen ist "das Datum" das Datum des Termins, nicht das der Veröffentlichung
+ * (z. B. in Beitragslisten des Themes und im Footer).
+ *
+ * @param string      $datum  Datum
+ * @param string      $format Format
+ * @param WP_Post|int $post   Beitrag
+ * @return string
+ */
+function el_team_termine_date( $datum, $format, $post ) {
+	$d = el_team_termin_daten( $post );
+	if ( ! $d ) {
+		return $datum;
+	}
+	return '' === $format ? el_team_termin_zeit_text( $post ) : wp_date( $format, $d['beginn']->getTimestamp() );
+}
+add_filter( 'get_the_date', 'el_team_termine_date', 10, 3 );
+
+/**
+ * Link zu OpenStreetMap für eine Adresse (keine eingebettete Karte).
+ *
+ * @param string $adresse Adresse
+ * @return string URL
+ */
+function el_team_termine_karte_url( $adresse ) {
+	return 'https://www.openstreetmap.org/search?query=' . rawurlencode( $adresse );
+}
+
+/**
+ * Infokasten eines Termins: Wann, Wo, Anmeldung, Kalender.
+ *
+ * @param int|WP_Post|null $post    Termin
+ * @param bool             $kompakt nur Wann und Wo (in Listen)
+ * @return string HTML
+ */
+function el_team_termin_info_html( $post = null, $kompakt = false ) {
+	$post = get_post( $post );
+	$d    = el_team_termin_daten( $post );
+	if ( ! $d ) {
+		return '';
+	}
+	$status = el_team_termin_status_liste();
+	ob_start();
+	?>
+	<div class="el-termin-info<?php echo '' !== $d['status'] ? ' is-' . esc_attr( $d['status'] ) : ''; ?><?php echo $kompakt ? ' el-termin-info--kompakt' : ''; ?>">
+		<?php if ( '' !== $d['status'] && isset( $status[ $d['status'] ] ) ) : ?>
+			<p class="el-termin-info__status"><?php echo esc_html( ucfirst( $status[ $d['status'] ] ) ); ?></p>
+		<?php endif; ?>
+		<dl class="el-termin-info__liste">
+			<dt><?php esc_html_e( 'Wann', 'el-team-termine' ); ?></dt>
+			<dd><time datetime="<?php echo esc_attr( $d['beginn']->format( 'c' ) ); ?>"><?php echo esc_html( el_team_termin_zeit_text( $post ) ); ?></time></dd>
+			<?php if ( '' !== $d['ort'] || '' !== $d['adresse'] ) : ?>
+				<dt><?php esc_html_e( 'Wo', 'el-team-termine' ); ?></dt>
+				<dd>
+					<?php echo esc_html( $d['ort'] ); ?>
+					<?php if ( '' !== $d['adresse'] ) : ?>
+						<?php echo '' !== $d['ort'] ? '<br>' : ''; ?><?php echo esc_html( $d['adresse'] ); ?>
+						<?php if ( ! $kompakt ) : ?>
+							<br><a href="<?php echo esc_url( el_team_termine_karte_url( $d['adresse'] ) ); ?>"><?php esc_html_e( 'Auf der Karte zeigen', 'el-team-termine' ); ?></a>
+						<?php endif; ?>
+					<?php endif; ?>
+				</dd>
+			<?php endif; ?>
+			<?php if ( ! $kompakt && '' !== $d['anmeldung'] ) : ?>
+				<dt><?php esc_html_e( 'Anmeldung', 'el-team-termine' ); ?></dt>
+				<dd><a href="<?php echo esc_url( $d['anmeldung'] ); ?>"><?php esc_html_e( 'Anmeldung und weitere Infos', 'el-team-termine' ); ?></a></dd>
+			<?php endif; ?>
+		</dl>
+		<?php if ( ! $kompakt ) : ?>
+			<p class="el-termin-info__kalender"><a href="<?php echo esc_url( el_team_termine_ics_url( $post ) ); ?>" download><?php esc_html_e( 'In den eigenen Kalender eintragen (.ics)', 'el-team-termine' ); ?></a></p>
+		<?php endif; ?>
+	</div>
+	<?php
+	return ob_get_clean();
+}
+
+/**
+ * Infokasten vor dem Text eines Termins: ausführlich auf der Terminseite, kurz in der Übersicht.
+ * Läuft nach der Absatzformatierung (wpautop), damit der Kasten unverändert bleibt.
+ *
+ * @param string $inhalt Inhalt
+ * @return string
+ */
+function el_team_termine_content( $inhalt ) {
+	if ( 'termin' !== get_post_type() || ! in_the_loop() || ! is_main_query() || doing_filter( 'get_the_excerpt' ) ) {
+		return $inhalt;
+	}
+	return el_team_termin_info_html( null, ! is_singular( 'termin' ) ) . $inhalt;
+}
+add_filter( 'the_content', 'el_team_termine_content', 20 );
+
+/**
+ * Terminliste (Shortcode [termine], Startseite des Themes).
+ *
+ * @param WP_Post[] $termine Termine
+ * @return string HTML
+ */
+function el_team_termine_liste_html( $termine ) {
+	if ( ! $termine ) {
+		return '';
+	}
+	$status = el_team_termin_status_liste();
+	ob_start();
+	?>
+	<ul class="el-termine">
+		<?php
+		foreach ( $termine as $termin ) :
+			$d = el_team_termin_daten( $termin );
+			if ( ! $d ) {
+				continue;
+			}
+			$ts         = $d['beginn']->getTimestamp();
+			$mehrtaegig = $d['ende'] && $d['ende']->format( 'Y-m-d' ) !== $d['beginn']->format( 'Y-m-d' );
+			if ( $mehrtaegig ) {
+				$wann = wp_date( 'j.n.', $ts ) . '–' . wp_date( 'j.n.', $d['ende']->getTimestamp() );
+			} elseif ( $d['ganztags'] ) {
+				$wann = wp_date( 'l', $ts );
+			} else {
+				/* translators: 1: Wochentag, 2: Uhrzeit */
+				$wann = sprintf( __( '%1$s, %2$s Uhr', 'el-team-termine' ), wp_date( 'l', $ts ), wp_date( 'G:i', $ts ) );
+			}
+			$meta = array_filter( array( $wann, $d['ort'] ) );
+			?>
+			<li class="el-termine__eintrag<?php echo '' !== $d['status'] ? ' is-' . esc_attr( $d['status'] ) : ''; ?>">
+				<time class="el-termine__datum" datetime="<?php echo esc_attr( $d['beginn']->format( 'c' ) ); ?>">
+					<span class="el-termine__tag"><?php echo esc_html( wp_date( 'j', $ts ) ); ?></span>
+					<span class="el-termine__monat"><?php echo esc_html( wp_date( 'M', $ts ) ); ?></span>
+				</time>
+				<span class="el-termine__text">
+					<a class="el-termine__titel" href="<?php echo esc_url( get_permalink( $termin ) ); ?>"><?php echo esc_html( get_the_title( $termin ) ); ?></a>
+					<span class="el-termine__meta">
+						<?php if ( '' !== $d['status'] && isset( $status[ $d['status'] ] ) ) : ?>
+							<strong class="el-termine__status"><?php echo esc_html( ucfirst( $status[ $d['status'] ] ) ); ?>:</strong>
+						<?php endif; ?>
+						<?php echo esc_html( implode( ' · ', $meta ) ); ?>
+					</span>
+				</span>
+			</li>
+		<?php endforeach; ?>
+	</ul>
+	<?php
+	return ob_get_clean();
+}
+
+/**
+ * Shortcode [termine anzahl="5" zeitraum="kommend" art=""].
+ *
+ * zeitraum: kommend (Standard), vergangen oder alle; art: Slug einer Terminart.
+ *
+ * @param array $atts Attribute
+ * @return string HTML
+ */
+function el_team_termine_shortcode( $atts ) {
+	$atts    = shortcode_atts( array(
+		'anzahl'   => 5,
+		'zeitraum' => 'kommend',
+		'art'      => '',
+	), $atts, 'termine' );
+	$termine = el_team_termine_query( array(
+		'anzahl'   => max( 1, min( 50, (int) $atts['anzahl'] ) ),
+		'zeitraum' => in_array( $atts['zeitraum'], array( 'kommend', 'vergangen', 'alle' ), true ) ? $atts['zeitraum'] : 'kommend',
+		'art'      => $atts['art'],
+	) )->posts;
+	if ( ! $termine ) {
+		return '<p class="el-termine-leer">' . esc_html__( 'Zurzeit stehen keine Termine an.', 'el-team-termine' ) . '</p>';
+	}
+	return el_team_termine_liste_html( $termine );
+}
+add_shortcode( 'termine', 'el_team_termine_shortcode' );
+
+/**
+ * Strukturierte Daten (schema.org/Event) auf der Terminseite, damit Suchmaschinen den Termin erkennen.
+ */
+function el_team_termine_json_ld() {
+	if ( ! is_singular( 'termin' ) ) {
+		return;
+	}
+	$post = get_queried_object();
+	$d    = el_team_termin_daten( $post );
+	if ( ! $d ) {
+		return;
+	}
+	$format = $d['ganztags'] ? 'Y-m-d' : 'c';
+	$daten  = array(
+		'@context'            => 'https://schema.org',
+		'@type'               => 'Event',
+		'name'                => wp_strip_all_tags( get_the_title( $post ) ),
+		'startDate'           => $d['beginn']->format( $format ),
+		'eventStatus'         => 'abgesagt' === $d['status'] ? 'https://schema.org/EventCancelled' : ( 'verschoben' === $d['status'] ? 'https://schema.org/EventPostponed' : 'https://schema.org/EventScheduled' ),
+		'eventAttendanceMode' => 'https://schema.org/OfflineEventAttendanceMode',
+		'url'                 => get_permalink( $post ),
+		'organizer'           => array(
+			'@type' => 'Organization',
+			'name'  => get_bloginfo( 'name' ),
+			'url'   => home_url( '/' ),
+		),
+	);
+	if ( $d['ende'] ) {
+		$daten['endDate'] = $d['ende']->format( $format );
+	}
+	if ( '' !== $d['ort'] || '' !== $d['adresse'] ) {
+		$daten['location'] = array(
+			'@type'   => 'Place',
+			'name'    => '' !== $d['ort'] ? $d['ort'] : $d['adresse'],
+			'address' => '' !== $d['adresse'] ? $d['adresse'] : $d['ort'],
+		);
+	}
+	if ( has_excerpt( $post ) ) {
+		$daten['description'] = wp_strip_all_tags( get_the_excerpt( $post ) );
+	}
+	if ( has_post_thumbnail( $post ) ) {
+		$daten['image'] = get_the_post_thumbnail_url( $post, 'large' );
+	}
+	echo '<script type="application/ld+json">' . wp_json_encode( $daten, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . "</script>\n";
+}
+add_action( 'wp_head', 'el_team_termine_json_ld' );
diff --git a/el-team-termine/includes/ical.php b/el-team-termine/includes/ical.php
new file mode 100644
index 0000000..cff1f71
--- /dev/null
+++ b/el-team-termine/includes/ical.php
@@ -0,0 +1,168 @@
+<?php
+/**
+ * Kalender-Export im iCalendar-Format (.ics):
+ * ?el_termin_ics=123 für einen Termin, ?el_termin_ics=alle für alle kommenden und die
+ * Termine der letzten 90 Tage (zum Abonnieren in Kalender-Apps).
+ */
+
+if ( ! defined( 'ABSPATH' ) ) {
+	exit;
+}
+
+/**
+ * Adresse der .ics-Datei.
+ *
+ * @param int|WP_Post|null $post Termin; ohne Angabe der Kalender mit allen Terminen
+ * @return string URL
+ */
+function el_team_termine_ics_url( $post = null ) {
+	$wert = $post ? get_post( $post )->ID : 'alle';
+	return add_query_arg( 'el_termin_ics', $wert, home_url( '/' ) );
+}
+
+/**
+ * Abfrage-Variable el_termin_ics.
+ *
+ * @param array $vars Abfrage-Variablen
+ * @return array
+ */
+function el_team_termine_ics_query_var( $vars ) {
+	$vars[] = 'el_termin_ics';
+	return $vars;
+}
+add_filter( 'query_vars', 'el_team_termine_ics_query_var' );
+
+/**
+ * Text für iCalendar maskieren (RFC 5545, 3.3.11).
+ *
+ * @param string $text Text
+ * @return string
+ */
+function el_team_termine_ics_text( $text ) {
+	$text = wp_strip_all_tags( html_entity_decode( $text, ENT_QUOTES, 'UTF-8' ) );
+	return str_replace( array( '\\', ';', ',', "\r\n", "\n" ), array( '\\\\', '\;', '\,', '\n', '\n' ), $text );
+}
+
+/**
+ * Zeile auf höchstens 75 Bytes falten (RFC 5545, 3.1), ohne UTF-8-Zeichen zu zerteilen.
+ *
+ * @param string $zeile Zeile
+ * @return string
+ */
+function el_team_termine_ics_fold( $zeile ) {
+	$aus   = '';
+	$teil  = '';
+	$laenge = 0;
+	foreach ( preg_split( '//u', $zeile, -1, PREG_SPLIT_NO_EMPTY ) as $zeichen ) {
+		$bytes = strlen( $zeichen );
+		if ( $laenge + $bytes > ( '' === $aus ? 75 : 74 ) ) {
+			$aus   .= ( '' === $aus ? '' : "\r\n " ) . $teil;
+			$teil   = '';
+			$laenge = 0;
+		}
+		$teil   .= $zeichen;
+		$laenge += $bytes;
+	}
+	return $aus . ( '' === $aus ? '' : "\r\n " ) . $teil;
+}
+
+/**
+ * VEVENT eines Termins.
+ *
+ * @param WP_Post $post Termin
+ * @return string[] Zeilen
+ */
+function el_team_termine_ics_event( $post ) {
+	$d = el_team_termin_daten( $post );
+	if ( ! $d ) {
+		return array();
+	}
+	$utc    = new DateTimeZone( 'UTC' );
+	$zeilen = array(
+		'BEGIN:VEVENT',
+		'UID:termin-' . $post->ID . '@' . wp_parse_url( home_url(), PHP_URL_HOST ),
+		'DTSTAMP:' . gmdate( 'Ymd\THis\Z', strtotime( $post->post_modified_gmt . ' UTC' ) ),
+		'SUMMARY:' . el_team_termine_ics_text( get_the_title( $post ) ),
+		'URL:' . get_permalink( $post ),
+	);
+	if ( $d['ganztags'] ) {
+		// Ganztägig: Ende ist der Tag nach dem letzten Tag
+		$ende     = $d['ende'] ? $d['ende'] : $d['beginn'];
+		$zeilen[] = 'DTSTART;VALUE=DATE:' . $d['beginn']->format( 'Ymd' );
+		$zeilen[] = 'DTEND;VALUE=DATE:' . $ende->modify( '+1 day' )->format( 'Ymd' );
+	} else {
+		$ende     = $d['ende'] ? $d['ende'] : $d['beginn']->modify( '+2 hours' );
+		$zeilen[] = 'DTSTART:' . $d['beginn']->setTimezone( $utc )->format( 'Ymd\THis\Z' );
+		$zeilen[] = 'DTEND:' . $ende->setTimezone( $utc )->format( 'Ymd\THis\Z' );
+	}
+	$ort = implode( ', ', array_filter( array( $d['ort'], $d['adresse'] ) ) );
+	if ( '' !== $ort ) {
+		$zeilen[] = 'LOCATION:' . el_team_termine_ics_text( $ort );
+	}
+	$beschreibung = has_excerpt( $post ) ? get_the_excerpt( $post ) : wp_trim_words( strip_shortcodes( $post->post_content ), 40 );
+	if ( '' !== $d['anmeldung'] ) {
+		$beschreibung .= "\n\n" . __( 'Anmeldung und Infos:', 'el-team-termine' ) . ' ' . $d['anmeldung'];
+	}
+	if ( '' !== trim( $beschreibung ) ) {
+		$zeilen[] = 'DESCRIPTION:' . el_team_termine_ics_text( $beschreibung );
+	}
+	if ( 'abgesagt' === $d['status'] ) {
+		$zeilen[] = 'STATUS:CANCELLED';
+	}
+	$zeilen[] = 'END:VEVENT';
+	return $zeilen;
+}
+
+/**
+ * Liefert die .ics-Datei aus, wenn ?el_termin_ics=… aufgerufen wird.
+ */
+function el_team_termine_ics_output() {
+	$wert = get_query_var( 'el_termin_ics' );
+	if ( '' === $wert ) {
+		return;
+	}
+	if ( 'alle' === $wert ) {
+		$termine = get_posts( array_merge( el_team_termine_query_vars( 'alle' ), array(
+			'post_type'      => 'termin',
+			'post_status'    => 'publish',
+			'posts_per_page' => 200,
+			'order'          => 'ASC',
+			'meta_query'     => array(
+				array(
+					'key'     => '_el_termin_bis',
+					'value'   => wp_date( 'Y-m-d H:i', time() - 90 * DAY_IN_SECONDS ),
+					'compare' => '>=',
+					'type'    => 'CHAR',
+				),
+			),
+		) ) );
+		$datei   = sanitize_title( get_bloginfo( 'name' ) ) . '-termine.ics';
+	} else {
+		$termin  = get_post( absint( $wert ) );
+		$termine = ( $termin && 'termin' === $termin->post_type && 'publish' === $termin->post_status ) ? array( $termin ) : array();
+		if ( ! $termine ) {
+			return;
+		}
+		$datei = $termin->post_name . '.ics';
+	}
+
+	$zeilen = array(
+		'BEGIN:VCALENDAR',
+		'VERSION:2.0',
+		'PRODID:-//' . el_team_termine_ics_text( get_bloginfo( 'name' ) ) . '//Termine//DE',
+		'CALSCALE:GREGORIAN',
+		'METHOD:PUBLISH',
+		'X-WR-CALNAME:' . el_team_termine_ics_text( get_bloginfo( 'name' ) . ' – ' . __( 'Termine', 'el-team-termine' ) ),
+	);
+	foreach ( $termine as $termin ) {
+		$zeilen = array_merge( $zeilen, el_team_termine_ics_event( $termin ) );
+	}
+	$zeilen[] = 'END:VCALENDAR';
+
+	nocache_headers();
+	header( 'Content-Type: text/calendar; charset=utf-8' );
+	header( 'Content-Disposition: ' . ( 'alle' === $wert ? 'inline' : 'attachment' ) . '; filename="' . $datei . '"' );
+	echo implode( "\r\n", array_map( 'el_team_termine_ics_fold', $zeilen ) ) . "\r\n"; // phpcs:ignore WordPress.Security.EscapeOutput -- iCalendar, oben maskiert.
+	exit;
+}
+add_action( 'template_redirect', 'el_team_termine_ics_output' );
